rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidMonthlySnapshot(month) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion',
          'month',
          'incomeCents',
          'expenseCents',
          'balanceCents',
          'portfolioCents',
          'portfolioContributionCents',
          'note',
          'version',
          'updatedAt',
          'deletedAt'
        ])
        && data.schemaVersion == 1
        && data.month == month
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.incomeCents is int
        && data.incomeCents >= 0
        && data.expenseCents is int
        && data.expenseCents >= 0
        && data.balanceCents is int
        && data.portfolioCents is int
        && data.portfolioCents >= 0
        && (!data.keys().hasAny(['portfolioContributionCents'])
          || data.portfolioContributionCents == null
          || (data.portfolioContributionCents is int && data.portfolioContributionCents >= 0))
        && data.note is string
        && data.note.size() <= 500
        && data.version is int
        && data.version >= 1
        && data.updatedAt == request.time
        && (data.deletedAt == null || data.deletedAt == request.time);
    }

    function isValidWealthGoal() {
      let data = request.resource.data;
      return data.keys().hasOnly(['schemaVersion', 'goal', 'version', 'updatedAt'])
        && data.schemaVersion == 1
        && data.version is int && data.version >= 1
        && data.updatedAt == request.time
        && (data.goal == null || (
          data.goal is map
          && data.goal.keys().hasOnly(['targetAmountCents', 'targetMonth'])
          && data.goal.targetAmountCents is int
          && data.goal.targetAmountCents > 0
          && data.goal.targetAmountCents <= 9007199254740991
          && data.goal.targetMonth is string
          && data.goal.targetMonth.matches('^[1-9][0-9]{3}-(0[1-9]|1[0-2])$')
        ));
    }

    match /users/{userId}/settings/wealthGoal {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidWealthGoal()
        && request.resource.data.version == 1;
      allow update: if isOwner(userId) && isValidWealthGoal()
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }

    match /users/{userId}/monthlySnapshots/{month} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidMonthlySnapshot(month)
        && request.resource.data.version == 1;
      allow update: if isOwner(userId)
        && isValidMonthlySnapshot(month)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
  }
}
