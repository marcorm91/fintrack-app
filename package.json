{
  "name": "fintrack-app",
  "private": true,
  "version": "3.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "node scripts/start-mocks.js",
    "tauri:dev:mocks": "node scripts/start-mocks.js --tauri",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings=0",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:patch": "node scripts/patch-android-immersive.js",
    "android:init": "tauri android init && npm run android:patch",
    "android:build": "npm run android:patch && tauri android build && node scripts/rename-android-outputs.js",
    "android:dev": "npm run android:patch && tauri android dev",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "2.9.1",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-fs": "2.4.4",
    "@tauri-apps/plugin-shell": "2.3.4",
    "@tauri-apps/plugin-sql": "2.3.1",
    "chart.js": "^4.4.3",
    "firebase": "^12.17.1",
    "i18next": "^23.12.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tauri-apps/cli": "2.9.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
