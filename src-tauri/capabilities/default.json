{
  "identifier": "default",
  "description": "Default capabilities for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:allow-open",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-download-read",
    "fs:allow-write-text-file",
    "sql:default",
    "sql:allow-execute"
  ]
}
